@{
    ViewBag.Title = "Customer Portal - Onboarding Videos";
    ViewBag.ActiveMenu = "Videos";
}

<div class="container-fluid">
    <div class="alert custOrderTab">
        <i class="fas fa-play-circle mr-2"></i> Customer portal - onboarding videos
    </div>

    <div class="table-responsive">
        <table class="table table-hover mt-3">
            <thead>
                <tr class="table-bordered text-center">
                    <th scope="col" style="width: 100px;">Serial No</th>
                    <th scope="col" class="text-left">Video Name</th>
                    <th scope="col" style="width: 100px;">Play</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row" class="text-center">1</th>
                    <td>Attendance process</td>
                    <td class="text-center"><button class="btn btn-sm btn-danger play-btn" data-video="Attendance.mp4"><i class="fa fa-play"></i></button></td>
                </tr>
                <tr>
                    <th scope="row" class="text-center">2</th>
                    <td>Biker service steps</td>
                    <td class="text-center"><button class="btn btn-sm btn-danger play-btn" data-video="Bikercustomerservicesteps.mp4"><i class="fa fa-play"></i></button></td>
                </tr>
                <tr>
                    <th scope="row" class="text-center">3</th>
                    <td>Cashier service steps</td>
                    <td class="text-center"><button class="btn btn-sm btn-danger play-btn" data-video="Cashierservicesteps.mp4"><i class="fa fa-play"></i></button></td>
                </tr>
                <tr>
                    <th scope="row" class="text-center">4</th>
                    <td>Customer measurement check</td>
                    <td class="text-center"><button class="btn btn-sm btn-danger play-btn" data-video="Customermeasurementcheckprocess.mp4"><i class="fa fa-play"></i></button></td>
                </tr>
                <tr>
                    <th scope="row" class="text-center">5</th>
