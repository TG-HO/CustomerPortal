                    <td class="text-center"><button class="btn btn-sm btn-danger play-btn" data-video="Dieselcustomerservicesteps.mp4"><i class="fa fa-play"></i></button></td>
                </tr>
                <tr>
                    <th scope="row" class="text-center">6</th>
                    <td>Entering quantity</td>
                    <td class="text-center"><button class="btn btn-sm btn-danger play-btn" data-video="Enteringquantity.mp4"><i class="fa fa-play"></i></button></td>
                </tr>
                <tr>
                    <th scope="row" class="text-center">7</th>
                    <td>HSSE basics</td>
                    <td class="text-center"><button class="btn btn-sm btn-danger play-btn" data-video="HSSEBasicstraining.mp4"><i class="fa fa-play"></i></button></td>
                </tr>
                <tr>
                    <th scope="row" class="text-center">8</th>
                    <td>Motorist service steps</td>
                    <td class="text-center"><button class="btn btn-sm btn-danger play-btn" data-video="Motoristcustomerservicesteps.mp4"><i class="fa fa-play"></i></button></td>
                </tr>
                <tr>
                    <th scope="row" class="text-center">9</th>
                    <td>Namaz SOP</td>
                    <td class="text-center"><button class="btn btn-sm btn-danger play-btn" data-video="NamazSOP.mp4"><i class="fa fa-play"></i></button></td>
                </tr>
                <tr>
                    <th scope="row" class="text-center">10</th>
                    <td>Nozzle handling</td>
                    <td class="text-center"><button class="btn btn-sm btn-danger play-btn" data-video="Nozzlehandling.mp4"><i class="fa fa-play"></i></button></td>
                </tr>
                <tr>
                    <th scope="row" class="text-center">11</th>
                    <td>Personal hygiene</td>
                    <td class="text-center"><button class="btn btn-sm btn-danger play-btn" data-video="Peronalhygienetraining.mp4"><i class="fa fa-play"></i></button></td>
                </tr>
                <tr>
                    <th scope="row" class="text-center">12</th>
                    <td>Personal grooming</td>
                    <td class="text-center"><button class="btn btn-sm btn-danger play-btn" data-video="Personalgroomingtraining.mp4"><i class="fa fa-play"></i></button></td>
