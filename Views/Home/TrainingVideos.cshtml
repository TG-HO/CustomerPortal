                </tr>
                <tr>
                    <th scope="row" class="text-center">14</th>
                    <td>Welcoming posture</td>
                    <td class="text-center"><button class="btn btn-sm btn-danger play-btn" data-video="Uniformguidelines.mp4"><i class="fa fa-play"></i></button></td>
                </tr>
                <tr>
                    <th scope="row" class="text-center">15</th>
                    <td>Decantation process</td>
                    <td class="text-center"><button class="btn btn-sm btn-danger play-btn" data-video="Decantationprocess.mp4"><i class="fa fa-play"></i></button></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const playButtons = document.querySelectorAll(".play-btn");
            playButtons.forEach(button => {
                button.addEventListener("click", function () {
                    const videoSrc = "@Url.Content("~/Content/videos/")" + this.dataset.video;
                    window.open(videoSrc, "Video Player", "width=800, height=600");
                });
            });
        });
    </script>
}
