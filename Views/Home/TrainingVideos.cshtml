<!-- Video Player Modal -->
<div class="modal fade" id="videoModal" tabindex="-1" role="dialog" aria-labelledby="videoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white py-3">
                <h5 class="modal-title font-weight-bold" id="videoModalLabel">
                    <i class="fas fa-play-circle text-danger mr-2"></i> <span id="modalVideoTitle">Video Lesson</span>
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-3 bg-black">
                <!-- Video Element -->
                <div class="embed-responsive embed-responsive-16by9 bg-dark rounded overflow-hidden" id="videoContainer">
                    <video id="trainingVideoPlayer" controls class="embed-responsive-item">
                        <source id="videoSource" src="" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>

                <!-- Missing/Sync Fallback Alert -->
                <div id="videoFallbackAlert" class="alert alert-warning mb-0 mt-2 p-3 text-dark d-none">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-info-circle fa-2x text-warning mr-3"></i>
                        <div>
                            <h6 class="font-weight-bold mb-1">Module Queued for Synchronization</h6>
                            <p class="mb-1 small">The high-definition video lesson for <strong id="fallbackVideoName">this module</strong> is currently being uploaded or synchronized by the Taj Gasoline Training Department.</p>
                            <p class="mb-0 small">Please refer to the comprehensive written <a href="@Url.Action("StationManual", "Home")" class="font-weight-bold text-danger text-underline">Station Operations Manual</a> or contact your Area Retail Manager.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <a href="@Url.Action("StationManual", "Home")" class="btn btn-outline-danger btn-sm font-weight-bold mr-auto">
                    <i class="fas fa-book-open mr-1"></i> View Related SOP in Station Manual
                </a>
                <button type="button" class="btn btn-secondary btn-sm px-4" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            var player = document.getElementById('trainingVideoPlayer');
            var source = document.getElementById('videoSource');
            var fallbackAlert = $('#videoFallbackAlert');
            var videoContainer = $('#videoContainer');

            $('.play-btn').on('click', function () {
                var videoFile = $(this).data('video');
                var videoTitle = $(this).data('title');

                $('#modalVideoTitle').text(videoTitle);
                $('#fallbackVideoName').text(videoTitle + ' (' + videoFile + ')');

                fallbackAlert.addClass('d-none');
                videoContainer.removeClass('d-none');

                var videoUrl = '@Url.Content("~/Content/videos/")' + videoFile;
                source.setAttribute('src', videoUrl);
                player.load();

                // Show modal
                $('#videoModal').modal('show');

                // Attempt playback with error detection
                var playPromise = player.play();
                if (playPromise !== undefined) {
                    playPromise.catch(function (error) {
                        console.log("Video autoplay prevented or file unavailable: ", error);
                    });
                }
            });

            // On video playback error
            player.addEventListener('error', function () {
                console.log("Video source error encountered.");
                videoContainer.addClass('d-none');
                fallbackAlert.removeClass('d-none');
            }, true);

            // Stop playback on modal close
            $('#videoModal').on('hidden.bs.modal', function () {
                player.pause();
                source.setAttribute('src', '');
                player.load();
                fallbackAlert.addClass('d-none');
                videoContainer.removeClass('d-none');
            });
        });
    </script>
}
