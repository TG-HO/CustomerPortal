@model CustomerPortal_MVC_.Models.CustOrderTable
@{
    ViewBag.Title = "Open Order Detail - " + Model.OrderPrefixId;
    ViewBag.ActiveMenu = "Orders";
}

<style>
    #status {
        width: 100% !important;
        padding: 0 !important;
    }

    .pipeline-step {
        display: inline-block;
        padding: 10px 20px;
        font-weight: 500;
        text-align: center;
        border-bottom: 3px solid #dee2e6;
    }

    .pipeline-step.active {
        border-bottom-color: #28a745;
        color: #28a745;
    }

    .pipeline-step.inactive {
        color: #6c757d;
    }
</style>

<div class="container-fluid">
    <div class="alert custOrderTab">
        <i class="fas fa-info-circle mr-2"></i> Order Detail: @Model.OrderPrefixId
    </div>

    <!-- Pipeline Step Bar matching PHP openorderdetail.php -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body p-3 text-center">
            <div class="d-flex justify-content-around flex-wrap">
                <div class="pipeline-step active">
                    <i class="fas fa-check text-success mr-1"></i> Submitted
                    <div class="small text-muted">@(Model.OrderCreatedOn.HasValue ? Model.OrderCreatedOn.Value.ToString("dd-MM-yyyy") : "-")</div>
                </div>
                <div class="pipeline-step @(Model.ApprovedStatus == 1 || Model.ReleasedFlag == 1 ? "active" : "inactive")">
                    <i class="fas @(Model.ApprovedStatus == 1 || Model.ReleasedFlag == 1 ? "fa-check text-success" : "fa-clock text-muted") mr-1"></i> Scheduled
                    <div class="small text-muted">@(Model.ApprovedDate.HasValue ? Model.ApprovedDate.Value.ToString("dd-MM-yyyy") : "-")</div>
                </div>
                <div class="pipeline-step @(Model.ShippedFlag == 1 ? "active" : "inactive")">
                    <i class="fas @(Model.ShippedFlag == 1 ? "fa-check text-success" : "fa-truck text-muted") mr-1"></i> Shipped
                    <div class="small text-muted">@(Model.ShippedFlag == 1 ? "In Transit" : "-")</div>
                </div>
                <div class="pipeline-step @(Model.ReceivedFlag == 1 ? "active" : "inactive")">
                    <i class="fas @(Model.ReceivedFlag == 1 ? "fa-check text-success" : "fa-box text-muted") mr-1"></i> Delivered
                    <div class="small text-muted">@(Model.ReceivedDateTime.HasValue ? Model.ReceivedDateTime.Value.ToString("dd-MM-yyyy") : "-")</div>
                </div>
                <div class="pipeline-step @(Model.ProfUploadFlag == 1 ? "active" : "inactive")">
                    <i class="fas @(Model.ProfUploadFlag == 1 ? "fa-check text-success" : "fa-file-invoice text-muted") mr-1"></i> Invoiced
                    <div class="small text-muted">@(Model.ProfUploadFlag == 1 ? "Invoiced" : "-")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <table class="table table-sm table-hover" id="customtab">
                <thead class="head">
                    <tr class="table-bordered text-black text-center">
                        <th scope="col">PO Number</th>
                        <th scope="col">Status</th>
                        <th scope="col">Item Code</th>
                        <th scope="col">Item Name</th>
                        <th scope="col">Unit</th>
                        <th scope="col">Quantity</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="text-black text-center">
                        <td>@Model.OrderPrefixId</td>
                        <td>
                            @if (Model.CancelFlag == 1)
                            {
                                <span class="badge badge-danger">Cancelled</span>
                            }
                            else if (Model.ReceivedFlag == 1)
                            {
                                <span class="badge badge-success">Delivered</span>
                            }
                            else if (Model.ShippedFlag == 1)
                            {
                                <span class="badge badge-info">Shipped</span>
                            }
                            else if (Model.ReleasedFlag == 1)
                            {
                                <span class="badge badge-primary">Released</span>
                            }
                            else
                            {
                                <span class="badge badge-warning">Pending</span>
                            }
                        </td>
                        <td>@Model.ProductCode</td>
                        <td>@(Model.ProductName ?? Model.ProductCode)</td>
                        <td>@(Model.Unit ?? "Litres")</td>
                        <td>@Model.RequiredQuantity.ToString("N0")</td>
                    </tr>
                </tbody>
            </table>

            <div class="d-flex justify-content-between mt-4">
                <a href="@Url.Action("OpenOrders", "Home")" class="btn btn-outline-secondary">
                    <i class="fa fa-arrow-left mr-1"></i> Back to Orders
                </a>

                @if (Model.ShippedFlag == 1 && (Model.ReceivedFlag ?? 0) == 0)
                {
                    <button type="button" class="btn btn-success" data-toggle="modal" data-target="#receiveModal">
                        <i class="fa fa-check mr-1"></i> Confirm Receipt
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal for Received Confirmation with Shortage inputs matching PHP -->
<div class="modal fade" id="receiveModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Confirm Delivery Receipt</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <form id="receiveForm">
                    <input type="hidden" name="orderPrefix" value="@Model.OrderPrefixId" />
                    <div class="form-group">
                        <label>Shortage (MM):</label>
                        <input type="text" name="mmsh" id="mmsh" class="form-control" value="0" placeholder="MM Shortage" />
                    </div>
                    <div class="form-group">
                        <label>Shortage (Liters):</label>
                        <input type="text" name="lssh" id="lssh" class="form-control" value="0" placeholder="Liters Shortage" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="btnConfirmReceived">Confirm Receipt</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            $('#btnConfirmReceived').click(function () {
                $.ajax({
                    url: "@Url.Action("ActionReceivedOrder", "Order")",
                    method: "POST",
                    data: $('#receiveForm').serialize(),
                    success: function (data) {
                        var res = typeof data === 'string' ? JSON.parse(data) : data;
                        if (res.status === 'success') {
                            Swal.fire('Confirmed', 'Order marked as received successfully.', 'success').then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('Error', 'Failed to confirm order receipt.', 'error');
                        }
                    }
                });
            });
        });
    </script>
}
