@model CustomerPortal_MVC_.Models.ViewModels.ChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
}

<style>
    #nav2 {
        display: none !important;
    }

    #changeform {
        padding: 20px;
        border: 1px solid white;
        width: 350px;
        max-width: 90%;
        margin: auto;
        margin-top: 7%;
        min-height: 330px;
        border-radius: 3px;
        box-shadow: 2px 2px 4px 2px gray;
        background-color: #fff;
    }

    .btn {
        margin-left: 70% !important;
        background-color: #ED1C24 !important;
        border-color: #ED1C24 !important;
    }
</style>

<div class="container-fluid">
    <div id="changeform">
        @if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
        {
            <div class="alert alert-success">@ViewBag.SuccessMessage</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(true, "", new { @class = "mb-0" })
            </div>
        }

        <form method="POST" id="changepassword" action="@Url.Action("ChangePassword", "Account")">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label for="oldpass">Old Password</label>
                <input type="password" class="form-control" name="OldPassword" id="oldpass" placeholder="Enter your old password" required>
            </div>
            <div class="form-group">
                <label for="newpass">New Password</label>
                <input type="password" class="form-control" id="newpass" name="NewPassword" placeholder="Enter your new password" disabled required>
            </div>
            <div class="form-group">
                <label for="confirmpass">Confirm Password</label>
                <input type="password" class="form-control" name="ConfirmPassword" id="confirmpass" placeholder="Confirm password" disabled required>
            </div>

            <button type="submit" id="submit" class="btn btn-danger pull-right" name="submit" disabled>Save</button>
        </form>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            let oldpass, newpass, confirmpass;

            $("#oldpass").blur(function () {
                oldpass = $(this).val();
                if (!oldpass) return;

                $.ajax({
                    url: "@Url.Action("VerifyCurrentPassword", "Account")",
                    method: "GET",
                    data: { oldpass: oldpass },
                    success: function (data) {
                        var res = typeof data === 'string' ? JSON.parse(data) : data;
                        if (res.message === "success") {
                            $("#newpass").prop('disabled', false);
                        } else {
                            Swal.fire("Enter correct password");
                            $("#newpass").prop('disabled', true);
                            $("#confirmpass").prop('disabled', true);
                            $("#submit").prop('disabled', true);
                        }
                    }
                });
            });

            $("#newpass").blur(function () {
                newpass = $(this).val();
                if (newpass) {
                    $("#confirmpass").prop('disabled', false);
                }
            });

            $("#confirmpass").blur(function () {
                confirmpass = $(this).val();
                newpass = $("#newpass").val();
                if (newpass === confirmpass && newpass !== '') {
                    $("#submit").prop('disabled', false);
                } else {
                    Swal.fire("Password do not match");
                    $("#submit").prop('disabled', true);
                }
            });
        });
    </script>
}
