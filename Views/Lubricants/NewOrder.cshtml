@model CustomerPortal_MVC_.Models.ViewModels.LubeOrderCreateViewModel
@{
    ViewBag.Title = "New Lubricant Order - Taj Gasoline";
    ViewBag.ActiveMenu = "Lubricants";
}

<div class="container-fluid">
    <div class="card shadow border-0 max-w-700 mx-auto">
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
            <h5 class="m-0 font-weight-bold"><i class="fa fa-plus-circle mr-2"></i>New Lubricant Order</h5>
        </div>
        <div class="card-body p-4">
            @using (Html.BeginForm("NewOrder", "Lubricants", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="form-group mb-3">
                    @Html.LabelFor(m => m.BrandId, "Select Brand", new { @class = "font-weight-bold" })
                    @Html.DropDownListFor(m => m.BrandId, (SelectList)ViewBag.Brands, "-- Select Lubricant Brand --", new { @class = "form-control", @id = "brandSelect" })
                    @Html.ValidationMessageFor(m => m.BrandId, "", new { @class = "text-danger small" })
                </div>

                <div class="form-group mb-3">
                    @Html.LabelFor(m => m.ProductCode, "Select Product", new { @class = "font-weight-bold" })
                    <select id="productSelect" name="ProductCode" class="form-control" required>
                        <option value="">-- Select Product --</option>
                    </select>
                    @Html.ValidationMessageFor(m => m.ProductCode, "", new { @class = "text-danger small" })
                </div>

                <div class="form-group mb-3">
                    @Html.LabelFor(m => m.Quantity, new { @class = "font-weight-bold" })
                    @Html.TextBoxFor(m => m.Quantity, new { @class = "form-control", @type = "number", @min = "1", @id = "qtyInput" })
                    @Html.ValidationMessageFor(m => m.Quantity, "", new { @class = "text-danger small" })
                </div>

                <div class="row bg-light p-3 rounded mb-4 mx-0 border">
                    <div class="col-md-6 mb-2">
                        <small class="text-muted d-block">Unit Price:</small>
                        <strong class="text-dark" id="unitPriceDisplay">PKR 0.00</strong>
                    </div>
                    <div class="col-md-6 mb-2">
                        <small class="text-muted d-block">Est. Total Amount:</small>
                        <strong class="text-danger" id="totalAmountDisplay">PKR 0.00</strong>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a href="@Url.Action("Index", "Lubricants")" class="btn btn-outline-secondary"><i class="fa fa-arrow-left mr-1"></i> Back</a>
                    <button type="submit" class="btn btn-danger px-4"><i class="fa fa-check mr-1"></i> Submit Order</button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            var selectedPrice = 0;

            $('#brandSelect').change(function () {
                var brandId = $(this).val();
                var $productSelect = $('#productSelect');
                $productSelect.empty().append('<option value="">-- Loading Products... --</option>');

                if (brandId) {
                    $.getJSON('@Url.Action("GetProductsByBrand", "Lubricants")', { brandId: brandId }, function (data) {
                        $productSelect.empty().append('<option value="">-- Select Product --</option>');
                        $.each(data, function (i, item) {
                            $productSelect.append($('<option>', {
                                value: item.productCode,
                                text: item.productName + ' (PKR ' + item.price + ')',
                                'data-price': item.price
                            }));
                        });
                    });
                } else {
                    $productSelect.empty().append('<option value="">-- Select Product --</option>');
                }
            });

            $('#productSelect').change(function () {
                var price = $(this).find(':selected').data('price') || 0;
                selectedPrice = parseFloat(price);
                $('#unitPriceDisplay').text('PKR ' + selectedPrice.toFixed(2));
                calculateTotal();
            });

            $('#qtyInput').on('input', function () {
                calculateTotal();
            });

            function calculateTotal() {
                var qty = parseFloat($('#qtyInput').val()) || 0;
                var total = qty * selectedPrice;
                $('#totalAmountDisplay').text('PKR ' + total.toFixed(2));
            }
        });
    </script>
}
