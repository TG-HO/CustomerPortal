@{
    Layout = "~/Views/Shared/_LubricantsLayout.cshtml";
    ViewBag.Title = "Taj Gasoline - New Lubricant Order";
    ViewBag.ActiveLubeMenu = "NewLubeOrder";
}

<!-- Page-Title -->
<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <div class="float-right">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Home", "Lubricants")">Lubricant Portal</a></li>
                    <li class="breadcrumb-item active">Home</li>
                </ol>
            </div>
            <h4 class="page-title">Lubricant Order Page</h4>
        </div>
    </div>
</div>

<!-- KPI Summary Cards -->
<div class="row">
    <div class="col-xl-3 col-lg-6">
        <div class="card l-bg-blue-dark grediant-red">
            <div class="card-statistic-3 p-4">
                <div class="card-icon card-icon-large"><i class="fas fa-users fa-5x"></i></div>
                <div class="mb-4">
                    <h5 class="card-title mb-0">CUSTOMER INFO</h5>
                </div>
                <div class="row align-items-center mb-2 d-flex">
                    <div class="col-12">
                        <h2 class="d-flex align-items-center mb-0">
                            <span id="customerInfo">-</span>
                        </h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-lg-6">
        <div class="card l-bg-cherry grediant-red">
            <div class="card-statistic-3 p-4">
                <div class="card-icon card-icon-large"><i class="fas fa-shopping-cart fa-5x"></i></div>
                <div class="mb-4">
                    <h5 class="card-title mb-0">NEW ORDERS</h5>
                </div>
                <div class="row align-items-center mb-2 d-flex">
                    <div class="col-8">
                        <h2 class="d-flex align-items-center mb-0 nw">
                            <span id="newOrders">-</span>
                        </h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-lg-6">
        <div class="card l-bg-green-dark grediant-red">
            <div class="card-statistic-3 p-4">
                <div class="card-icon card-icon-large"><i class="fas fa-shopping-cart fa-5x"></i></div>
                <div class="mb-4">
                    <h5 class="card-title mb-0">COMPLETED ORDERS</h5>
                </div>
                <div class="row align-items-center mb-2 d-flex">
                    <div class="col-8">
                        <h2 class="d-flex align-items-center mb-0">
                            <span id="completedOrders">-</span>
                        </h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-lg-6">
        <div class="card l-bg-orange-dark grediant-red">
            <div class="card-statistic-3 p-4">
                <div class="card-icon card-icon-large"><i class="fas fa-dollar-sign fa-5x"></i></div>
                <div class="mb-4">
                    <h5 class="card-title mb-0">BALANCE</h5>
                </div>
                <div class="row align-items-center mb-2 d-flex">
                    <div class="col-8">
                        <h2 class="d-flex align-items-center mb-0">
                            <span id="balance" style="font-size: 1rem !important;">-</span>
                        </h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Section 1: Order Headers Datatable -->
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="text-left">
                    <button class="btn btn-block waves-effect waves-light btn-red" id="btnCreateHead" style="width: 10rem; margin-bottom: 1rem;" onclick="createHead();" type="button">New Order</button>
                    <table id="datatable" class="table table-bordered dt-responsive nowrap" style="overflow-x: auto; border-collapse: collapse; border-spacing: 0; width: 100%;">
                        <thead class="custom-thead">
                            <tr>
                                <th style="width: 10%" class="middle-center-table-cells">OrderID</th>
                                <th style="width: 17%" class="middle-center-table-cells">Customer Code</th>
                                <th style="width: 17%" class="middle-center-table-cells">Customer Site</th>
                                <th style="width: 17%" class="middle-center-table-cells">Order Date</th>
                                <th style="width: 17%" class="middle-center-table-cells">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Section 2: Order in Progress Entry Form -->
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="text-left">
                    <h4 class="page-title" style="color: red; font-weight: 700; font-size: 1.5rem;">
                        Order in Progress : <span id="ref_head_order">-</span><span style="font-size: 1.2rem;"> (Please ensure that ordered pieces are equal to cartons)</span>
                    </h4>
                    <div class="table-responsive">
                        <table class="table table-bordered dt-responsive nowrap" style="width: 100%;">
                            <thead class="custom-thead">
                                <tr>
                                    <th style="width: 10%" class="middle-center-table-cells">Brand</th>
                                    <th style="width: 10%" class="middle-center-table-cells">Category</th>
                                    <th style="width: 10%" class="middle-center-table-cells">Product</th>
                                    <th style="width: 10%" class="middle-center-table-cells">Image</th>
                                    <th style="width: 10%" class="middle-center-table-cells">Rates</th>
                                    <th style="width: 10%" class="middle-center-table-cells">Unit</th>
                                    <th style="width: 10%" class="middle-center-table-cells">Qty</th>
                                    <th style="width: 10%" class="middle-center-table-cells">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <select class="form-control mb-3 custom-select" style="width: 100%; height: 36px;" id="Brands" onchange="getFilteredProducts();" disabled>
                                        </select>
                                    </td>
                                    <td>
                                        <select class="form-control mb-3 custom-select" style="width: 100%; height: 36px;" id="Categories" onchange="getFilteredProducts();" disabled>
                                        </select>
                                    </td>
                                    <td>
                                        <select class="form-control mb-3 custom-select ProductImage" style="width: 100%; height: 36px;" id="Products" disabled onchange="getPrice();">
                                            <option value="-1" selected disabled> -- SELECT -- </option>
                                        </select>
                                    </td>
                                    <td>
                                        <img id="productImage" class="thumb-xl rounded" src="@Url.Content("~/Content/lubricants/images/img-not-available.jpg")" onerror="this.onerror=null;this.src='@Url.Content("~/Content/lubricants/images/img-not-available.jpg")';" alt="images">
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" id="Rates" placeholder="Rates" disabled>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" id="Unit" placeholder="Unit" disabled>
                                    </td>
                                    <td>
                                        <input type="number" min="1" class="form-control" id="Qty" placeholder="Qty" disabled>
                                        <input type="text" class="form-control" id="sitename" hidden>
                                    </td>
                                    <td>
                                        <button id="btnAdd" class="btn btn-sm ml-3 btn-success btn-green" style="background-color: #4a53c4 !important; width: 10rem;" disabled><i class="fas fa-shopping-cart mb-2"></i> Add to Cart</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Section 3: Cart Lines Datatable -->
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="text-left">
                    <div class="table-responsive">
                        <table id="datatable3" class="table table-bordered dt-responsive nowrap" style="overflow-x: auto; border-collapse: collapse; border-spacing: 0; width: 100%;">
                            <thead class="custom-thead">
                                <tr>
                                    <th style="width: 10%" class="middle-center-table-cells">Order Reference</th>
                                    <th style="width: 10%" class="middle-center-table-cells">Line Number</th>
                                    <th style="width: 10%" class="middle-center-table-cells">Product Name</th>
                                    <th style="width: 10%" class="middle-center-table-cells">Rates</th>
                                    <th style="width: 10%" class="middle-center-table-cells">Unit</th>
                                    <th style="width: 10%" class="middle-center-table-cells">Quantity</th>
                                    <th style="width: 10%" class="middle-center-table-cells">Amount</th>
                                    <th style="width: 10%" class="middle-center-table-cells">Order Date</th>
                                    <th style="width: 10%" class="middle-center-table-cells">Action</th>
                                </tr>
                            </thead>
                            <tbody id="displayingdata">
                            </tbody>
                        </table>
                    </div>
                    <div class="text-center mt-3">
                        <button class="btn btn-sm ml-3 btnFinal btn-green" style="width: 10rem;"><i class="fas fa-shopping-cart mb-2"></i> PLACE ORDER</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        var imageBaseUrl = '@Url.Content("~/Content/lubricants/images/")';
        var fallbackImage = '@Url.Content("~/Content/lubricants/images/img-not-available.jpg")';

        $(document).ready(function () {
            loadingdata();
            tbllube();
            tblorders();
            tblBrands();
        });

        function loadingdata() {
            $.get('@Url.Action("ApiHome", "Lubricants")', function (data) {
                var res = (typeof data === 'string') ? JSON.parse(data) : data;
                $("#customerInfo").text(res.customerInfo);
                $("#newOrders").text(res.newOrders);
                $("#completedOrders").text(res.completeOrders);
                $("#balance").text(res.balance);
            });
        }

        $.fn.dataTable.ext.errMode = 'none';

        function tbllube() {
            if ($.fn.DataTable.isDataTable('#datatable')) {
                $('#datatable').DataTable().destroy();
            }

            $("#datatable").DataTable({
                "ajax": {
                    "url": '@Url.Action("ApiTblNewLubeOrder", "Lubricants")',
                    "type": "GET",
                    "dataSrc": function (json) {
                        if (json && json.data && Array.isArray(json.data)) {
                            return json.data;
                        }
                        return [];
                    },
                    "error": function (xhr, error, code) {
                        console.warn("DataTables Ajax error:", error, code);
                    }
                },
                "bFilter": false,
                "bInfo": false,
                "bPaginate": false,
                "columns": [
                    { "data": "ORDERID" },
                    { "data": "CUSTOMERCODE" },
                    { "data": "CUSTSITE" },
                    { "data": "CREATEDDATETIME" },
                    { "data": "Empty" }
                ]
            });
        }

        function tblorders() {
            var vorderHead = $("#ref_head_order").text();

            $.ajax({
                url: '@Url.Action("ApiTblOrderDetails", "Lubricants")',
                method: "POST",
                data: {
                    ORDERNUMBERss: vorderHead
                },
                success: function (data) {
                    var res = (typeof data === 'string') ? JSON.parse(data) : data;
                    $("#displayingdata").html(res.Tabledata || "");
                }
            });
        }

        function tblBrands() {
            $.get('@Url.Action("ApiGetBrands", "Lubricants")', function (data) {
                var res = (typeof data === 'string') ? JSON.parse(data) : data;
                $("#Brands").html(res.Brands);
                $("#Categories").html(res.Categories);
            });
        }

        function getFilteredProducts() {
            var Category = $("#Categories").val();
            var Brand = $("#Brands").val();

            if (!Category || !Brand || Category == -1 || Brand == -1) {
                return;
            }

            $.ajax({
                url: '@Url.Action("ApiGetFilteredProducts", "Lubricants")',
                method: 'POST',
                data: {
                    Category: Category,
                    Brand: Brand
                },
                dataType: "JSON",
                success: function (data) {
                    var res = (typeof data === 'string') ? JSON.parse(data) : data;
                    if (res.status == 'success') {
                        $("#Products").html(res.result);
                    }
                }
            });
        }

        function getPrice() {
            var Products = $("#Products").val();
            var Productsname = 'img-not-available';

            if (!Products || Products == -1) {
                return;
            }

            $.ajax({
                url: '@Url.Action("ApiGetPrice", "Lubricants")',
                method: 'POST',
                data: {
                    Products: Products
                },
                dataType: "JSON",
                success: function (data) {
                    var res = (typeof data === 'string') ? JSON.parse(data) : data;
                    if (res.status == 'success') {
                        $("#Rates").val(res.ProductsPrice);
                        $("#Unit").val(res.Unit);
                        if (!res.ProductsName || res.ProductsName == "null" || res.ProductsName == "") {
                            Productsname = 'img-not-available';
                        } else {
                            Productsname = res.ProductsName;
                        }

                        $('#productImage').attr('src', imageBaseUrl + Productsname + '.jpg');
                    }
                }
            });
        }

        function createHead() {
            $('#btnCreateHead').prop('disabled', true);
            $.get('@Url.Action("ApiNewOrderHead", "Lubricants")', function (data) {
                var res = (typeof data === 'string') ? JSON.parse(data) : data;
                $('#btnCreateHead').prop('disabled', false);
                if (res.status == 'success') {
                    tbllube();
                    loadingdata();
                } else {
                    Swal.fire({
                        title: "Oops! Some Error Occurred",
                        text: res.message || "",
                        icon: "error",
                        timer: 4000,
                        showConfirmButton: true
                    });
                    tbllube();
                }
            }).fail(function () {
                $('#btnCreateHead').prop('disabled', false);
            });
        }

        $(document).on("click", ".DeleteHeadButton", function () {
            var varorderid = $(this).data("orderid");
            $.ajax({
                url: '@Url.Action("ApiDeleteOrderHead", "Lubricants")',
                method: 'POST',
                data: {
                    orderHeadRef: varorderid
                },
                success: function (data) {
                    var res = (typeof data === 'string') ? JSON.parse(data) : data;
                    if (res.status == 'success') {
                        tbllube();
                        loadingdata();
                    } else if (res.orderlines == 'exist') {
                        Swal.fire({
                            icon: 'error',
                            text: 'Could not Delete Because Order Lines Exist',
                            confirmButtonText: 'Okay',
                            allowOutsideClick: false
                        });
                    }
                }
            });
        });

        $(document).on("click", ".btnUseOrder", function () {
            var orderHeadRef = $(this).data("orderhead");

            $("#ref_head_order").text("TLB-" + orderHeadRef);
            $("#sitename").val(orderHeadRef);

            $("#Brands").prop("disabled", false);
            $("#Categories").prop("disabled", false);
            $("#Products").prop("disabled", false);
            $("#Qty").prop("disabled", false);
            $("#btnAdd").prop("disabled", false);

            $(".DeleteHeadButton").prop("disabled", false);
            $("#btnDeleteOrder" + orderHeadRef).prop("disabled", true);

            tblorders();
        });

        $("#btnAdd").on('click', function () {
            var productname = $("#Products option:selected").attr('name') || $("#Products option:selected").data('name');
            var siteName = $("#sitename").val();
            var product = $("#Products").val();
            var prod_brand = $("#Brands").val();
            var prod_category = $("#Categories").val();
            var rates = $("#Rates").val();
            var unit = $("#Unit").val();
            var qty = $("#Qty").val();
            var orderRef = $("#ref_head_order").text();

            if (!product || product == -1 || !qty || qty <= 0 || !prod_brand || prod_brand == -1 || !prod_category || prod_category == -1 || orderRef == "-" || !orderRef) {
                Swal.fire({
                    icon: "error",
                    text: "Please select an active Order Head and fill in all fields with valid quantity",
                    allowOutsideClick: false,
                    confirmButtonText: "Okay"
                });
                return;
            }

            $.ajax({
                url: '@Url.Action("ApiActionNewLubeOrder", "Lubricants")',
                method: 'POST',
                data: {
                    siteName: siteName,
                    productname: productname,
                    product: product,
                    prod_brand: prod_brand,
                    prod_category: prod_category,
                    rates: rates,
                    unit: unit,
                    qty: qty,
                    orderRef: orderRef
                },
                success: function (data) {
                    var res = (typeof data === 'string') ? JSON.parse(data) : data;
                    if (res.status == 'success') {
                        $('#Products').prop('selectedIndex', 0);
                        $('#Brands').prop('selectedIndex', 0);
                        $('#Categories').prop('selectedIndex', 0);
                        $("#Rates").val('');
                        $("#Unit").val('');
                        $("#Qty").val('');
                        $('#productImage').attr('src', fallbackImage);
                        tblorders();
                        loadingdata();
                    } else {
                        Swal.fire({
                            icon: "error",
                            text: res.message || "Failed to add item",
                            confirmButtonText: "Okay"
                        });
                    }
                }
            });
        });

        $(document).on("click", ".btnDel", function () {
            var id = $(this).data('id');

            Swal.fire({
                title: "Are you sure?",
                text: 'Are you sure you want to cancel item: ' + id + ' ?',
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes!"
            }).then((result) => {
                if (result.isConfirmed || result.value) {
                    $.ajax({
                        url: '@Url.Action("ApiDeleteLubeOrders3", "Lubricants")',
                        method: 'POST',
                        data: { id: id },
                        success: function (data) {
                            var res = (typeof data === 'string') ? JSON.parse(data) : data;
                            if (res.status == 'success') {
                                tblorders();
                                loadingdata();
                            } else {
                                alert("Something went wrong");
                            }
                        }
                    });
                }
            });
        });

        $(".btnFinal").on('click', function () {
            var orderHead = $("#ref_head_order").text();
            if (orderHead == "-" || !orderHead) {
                alert('Please Select Order Head First');
                return;
            }

            Swal.fire({
                icon: 'info',
                title: 'Are you sure you want to place Order no. ' + orderHead + ' ?',
                text: 'Mode of Payment: Advance.',
                allowOutsideClick: false,
                showCancelButton: true,
                confirmButtonText: 'Yes, Place Order',
                cancelButtonText: 'No, Wait'
            }).then((result) => {
                if (result.isConfirmed || result.value) {
                    $.ajax({
                        url: '@Url.Action("ApiActionFinalOrder", "Lubricants")',
                        method: "POST",
                        data: {
                            orderHead: orderHead
                        },
                        dataType: "JSON",
                        success: function (data) {
                            var res = (typeof data === 'string') ? JSON.parse(data) : data;
                            if (res.status == 'success') {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Order Placed Successfully!',
                                    text: 'Order ' + orderHead + ' has been placed.',
                                    confirmButtonText: 'Okay'
                                });
                                $("#ref_head_order").text("-");
                                $("#Brands").prop("disabled", true).prop('selectedIndex', 0);
                                $("#Categories").prop("disabled", true).prop('selectedIndex', 0);
                                $("#Products").prop("disabled", true).empty().append('<option value="-1" selected disabled> -- SELECT -- </option>');
                                $("#Qty").prop("disabled", true).val('');
                                $("#Rates").val('');
                                $("#Unit").val('');
                                $("#btnAdd").prop("disabled", true);
                                $('#productImage').attr('src', fallbackImage);
                                tbllube();
                                tblorders();
                                loadingdata();
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error placing order',
                                    text: res.message || "Failed to place order."
                                });
                            }
                        }
                    });
                }
            });
        });
    </script>
}
