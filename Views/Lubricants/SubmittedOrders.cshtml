@{
    Layout = "~/Views/Shared/_LubricantsLayout.cshtml";
    ViewBag.Title = "Taj Gasoline - Submitted Orders Page";
    ViewBag.ActiveLubeMenu = "SubmittedOrders";
}

<!-- Page-Title -->
<div class="row">
    <div class="col-sm-12">
        <div class="page-title-box">
            <div class="float-right">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Home", "Lubricants")">Lubricant Portal</a></li>
                    <li class="breadcrumb-item active">Home</li>
                </ol>
            </div>
            <h4 class="page-title">Submitted Orders Page</h4>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="text-left">
                    <div class="table-responsive">
                        <table id="datatable" class="table table-bordered dt-responsive nowrap" style="overflow-x: auto; border-collapse: collapse; border-spacing: 0; width: 100%;">
                            <thead class="custom-thead">
                                <tr>
                                    <th style="width: 10%">Order Date</th>
                                    <th style="width: 10%">Order Number</th>
                                    <th style="width: 10%">Line Number</th>
                                    <th style="width: 10%">Customer Code</th>
                                    <th style="width: 10%">Site Name</th>
                                    <th style="width: 10%">Product Code</th>
                                    <th style="width: 10%">Product Name</th>
                                    <th style="width: 10%">Unit</th>
                                    <th style="width: 10%">Ordered Qty</th>
                                    <th style="width: 10%">Rates</th>
                                    <th style="width: 10%">Amount</th>
                                    <th style="width: 10%">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            tblOrders();
        });

        $.fn.dataTable.ext.errMode = 'none';

        function tblOrders() {
            if ($.fn.DataTable.isDataTable('#datatable')) {
                $('#datatable').DataTable().destroy();
            }

            $("#datatable").DataTable({
                "ajax": {
                    "url": '@Url.Action("ApiTblSubmittedOrders", "Lubricants")',
                    "type": "GET",
                    "dataSrc": function (json) {
                        if (json && json.data && Array.isArray(json.data)) {
                            return json.data;
                        }
                        return [];
                    },
                    "error": function (xhr, error, code) {
                        console.warn("DataTables Ajax error:", error, code);
                    }
                },
                "dom": 'Bfrtip',
                "buttons": [
                    'copyHtml5',
                    'excelHtml5',
                    'csvHtml5',
                    'pdfHtml5'
                ],
                "columns": [
                    { "data": "createdondatetime" },
                    { "data": "ordernumber" },
                    { "data": "linenumber" },
                    { "data": "customercode" },
                    { "data": "sitename" },
                    { "data": "productcode" },
                    { "data": "productname" },
                    { "data": "unit" },
                    { "data": "requiredqty" },
                    { "data": "productrates" },
                    { "data": "totalamount" },
                    { "data": "orderstatus" }
                ],
                "order": [[2, "desc"]]
            });
        }

        $(document).on("click", ".btnDelete", function () {
            var id = $(this).data('id');
            Swal.fire({
                title: "Are you sure?",
                text: 'Are you sure you want to cancel Order Line Number : ' + id + ' ?',
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes!"
            }).then((result) => {
                if (result.isConfirmed || result.value) {
                    $.ajax({
                        url: '@Url.Action("ApiDeleteLubeOrders", "Lubricants")',
                        method: 'POST',
                        data: { id: id },
                        success: function (data) {
                            var res = (typeof data === 'string') ? JSON.parse(data) : data;
                            if (res.status == 'success') {
                                tblOrders();
                            } else {
                                alert("Something went wrong");
                            }
                        }
                    });
                }
            });
        });
    </script>
}
