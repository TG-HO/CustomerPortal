@model List<CustomerPortal_MVC_.Models.CpDeposit>
@{
    ViewBag.Title = "Customer Payments - Admin";
    ViewBag.ActiveMenu = "CustomerPayments";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fa fa-money text-danger mr-2"></i>Customer Payments</h1>
    </div>

    <div class="card shadow border-0 mb-4">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold"><i class="fa fa-list mr-2"></i>Uploaded Deposit Slips</h6>
            <span class="badge badge-danger">@(Model != null ? Model.Count : 0) Records</span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped table-bordered" id="customerPaymentsTable">
                    <thead class="thead-dark">
                        <tr class="text-center">
                            <th>ID</th>
                            <th>Customer Account</th>
                            <th>Bank</th>
                            <th>Amount (PKR)</th>
                            <th>Deposit Date</th>
                            <th>Description</th>
                            <th>Slip Attachment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr class="text-center">
                                    <td>@item.Id</td>
                                    <td class="font-weight-bold">@item.AccountCode</td>
                                    <td>@(item.DsBank ?? item.Bank ?? "-")</td>
                                    <td class="font-weight-bold text-success">@(item.NumericAmount > 0 ? item.NumericAmount.ToString("N2") : item.Amount)</td>
                                    <td>@(item.DsDate.HasValue ? item.DsDate.Value.ToString("yyyy-MM-dd") : "-")</td>
                                    <td>@(item.DsDesc ?? item.Description ?? "-")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.DsUpload))
                                        {
                                            <a href="@Url.Content("~/images/ds/" + item.DsUpload)" target="_blank" class="btn btn-sm btn-outline-danger">
                                                <i class="fa fa-file-image-o mr-1"></i> View Slip
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No File</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('#customerPaymentsTable').DataTable({
                "ordering": false,
                "language": {
                    "searchPlaceholder": "Search payment records..."
                }
            });
        });
    </script>
}
