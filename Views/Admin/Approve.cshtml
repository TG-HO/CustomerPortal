@model CustomerPortal_MVC_.Models.ViewModels.OrderApproveViewModel
@{
    ViewBag.Title = "Approve Order - " + Model.OrderPrefixId;
    ViewBag.ActiveMenu = "AdminDashboard";
}

<div class="container-fluid">
    <div class="card shadow border-0 max-w-700 mx-auto">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="m-0 font-weight-bold"><i class="fa fa-check-square-o mr-2"></i>Approve / Release Order</h5>
            <span class="badge badge-danger">@Model.OrderPrefixId</span>
        </div>
        <div class="card-body p-4">
            @using (Html.BeginForm("Approve", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.OrderPrefixId)
                @Html.HiddenFor(m => m.CustomerId)
                @Html.HiddenFor(m => m.RequiredQuantity)

                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="row bg-light p-3 rounded mb-4 mx-0 border">
                    <div class="col-md-6 mb-2">
                        <small class="text-muted d-block">Customer Account:</small>
                        <strong class="text-dark">@Model.CustomerId</strong>
                    </div>
                    <div class="col-md-6 mb-2">
                        <small class="text-muted d-block">Total Required Quantity:</small>
                        <strong class="text-danger">@Model.RequiredQuantity.ToString("N0") Liters</strong>
                    </div>
                </div>

                <div class="form-group mb-3">
                    @Html.LabelFor(m => m.ReleaseQty, new { @class = "font-weight-bold" })
                    @Html.TextBoxFor(m => m.ReleaseQty, new { @class = "form-control", @type = "number", @min = "0", @max = Model.RequiredQuantity, @id = "releaseQtyInput" })
                    <small class="text-muted">Enter less than required quantity for a partial release split.</small>
                    @Html.ValidationMessageFor(m => m.ReleaseQty, "", new { @class = "text-danger small" })
                </div>

                <div class="form-group mb-4">
                    @Html.LabelFor(m => m.HoldFreeQty, new { @class = "font-weight-bold" })
                    @Html.TextBoxFor(m => m.HoldFreeQty, new { @class = "form-control", @type = "number", @min = "0", @id = "hfQtyInput" })
                    @Html.ValidationMessageFor(m => m.HoldFreeQty, "", new { @class = "text-danger small" })
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary"><i class="fa fa-arrow-left mr-1"></i> Cancel</a>
                    <button type="submit" class="btn btn-danger px-4"><i class="fa fa-check mr-1"></i> Confirm Order Release</button>
                </div>
            }
        </div>
    </div>
</div>
