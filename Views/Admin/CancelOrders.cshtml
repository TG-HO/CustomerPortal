@model List<CustomerPortal_MVC_.Models.CustOrderTable>
@{
    ViewBag.Title = "Cancelled Orders - Admin";
    ViewBag.ActiveMenu = "CancelOrders";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fa fa-times-circle text-danger mr-2"></i>Cancelled Orders</h1>
    </div>

    <div class="card shadow border-0 mb-4">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold"><i class="fa fa-list mr-2"></i>List of Cancelled Orders</h6>
            <span class="badge badge-danger">@(Model != null ? Model.Count : 0) Cancelled</span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped table-bordered" id="cancelOrdersTable">
                    <thead class="thead-dark">
                        <tr class="text-center">
                            <th>Order Date</th>
                            <th>Order ID</th>
                            <th>Customer ID</th>
                            <th>Product</th>
                            <th>Ordered Qty</th>
                            <th>Cancelled On</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr class="text-center">
                                    <td>@(item.OrderCreatedOnDateTime.HasValue ? item.OrderCreatedOnDateTime.Value.ToString("yyyy-MM-dd HH:mm") : "-")</td>
                                    <td class="font-weight-bold text-danger">@item.OrderPrefixId</td>
                                    <td>@item.OrderCreatedUser</td>
                                    <td>@(item.ProductName ?? item.ProductCode)</td>
                                    <td>@((item.RequiredQuantity ?? 0).ToString("N0")) L</td>
                                    <td>@(item.CancelDateTime.HasValue ? item.CancelDateTime.Value.ToString("yyyy-MM-dd HH:mm") : "-")</td>
                                    <td><span class="badge badge-danger">Cancelled</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('#cancelOrdersTable').DataTable({
                "ordering": false,
                "language": {
                    "searchPlaceholder": "Search cancelled orders..."
                }
            });
        });
    </script>
}
